import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, confusion_matrix, ConfusionMatrixDisplay

data = pd.DataFrame({
    'RAM': [2,3,4,6,8,12,2,4,6,8,3,12,4,8,6,12],
    'Battery': [2000,2500,3000,4000,4500,5000,
                2200,3200,3800,4600,2600,5200,
                3100,4800,3900,5100],
    'Price': [0,0,1,1,2,3,0,1,1,2,0,3,1,2,1,3]
})

X = data[['RAM','Battery']]
y = data['Price']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

model = DecisionTreeClassifier(random_state=42)
model.fit(X_train, y_train)

pred = model.predict(X_test)

print("Accuracy:", accuracy_score(y_test, pred))
print("Predicted Price Range:",
      model.predict([[8,4500]])[0])

cm = confusion_matrix(y_test, pred)

ConfusionMatrixDisplay(
    confusion_matrix=cm
).plot(cmap='Purples')

plt.title("Mobile Price Classification")
plt.show()
